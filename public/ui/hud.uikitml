<!--
  HUD panel: ScreenSpace overlay in the browser (user POV), world-space panel
  at its authored transform in immersive XR. Horizon kit components.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 300px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 14px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .heading {
    height: 40px;
    text-align: center;
    font-size: 20px;
    font-weight: 700;
    line-height: 20px;
    letter-spacing: -0.5px;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .status {
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    line-height: 20px;
    margin-top: 8px;
    color: #0b6bcb;
  }

  .status:dark {
    color: #7cc4ff;
  }

  .sub-heading {
    color: #272727;
    font-size: 13px;
    font-weight: 500;
    line-height: 16px;
    width: 100%;
    margin-top: 8px;
    text-align: center;
  }

  .sub-heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .button {
    justify-content: flex-start;
    margin-left: 20px;
    margin-right: 20px;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">Deep Space Dive</div>
    <Divider></Divider>
    <div id="hud-status" class="status">Your Room</div>
    <div class="sub-heading">
      Press Dive to dissolve the room. Press Return to come back.
    </div>
  </div>
  <Button id="btn-dive" class="button">
    <ButtonLabel class="button-label">Dive into Deep Space</ButtonLabel>
  </Button>
  <Button id="btn-return" class="button" style="display: none">
    <ButtonLabel class="button-label">Return to Room</ButtonLabel>
  </Button>
</Panel>

<!--
  Hand panel: compact world-space panel. Placed front-left in the authored
  scene for desktop; DiveSystem moves it to follow the left grip in XR.
-->
<style>
  .panel-root {
    flex-direction: column;
    width: 240px;
  }

  .panel-content {
    align-items: center;
    flex-direction: column;
    padding-top: 12px;
    padding-left: 16px;
    padding-right: 16px;
  }

  .heading {
    height: 32px;
    text-align: center;
    font-size: 17px;
    font-weight: 700;
    line-height: 18px;
    letter-spacing: -0.5px;
    color: #272727;
  }

  .heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .status {
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    line-height: 18px;
    margin-top: 6px;
    color: #0b6bcb;
  }

  .status:dark {
    color: #7cc4ff;
  }

  .sub-heading {
    color: #272727;
    font-size: 12px;
    font-weight: 500;
    line-height: 15px;
    width: 100%;
    margin-top: 6px;
    text-align: center;
  }

  .sub-heading:dark {
    color: rgba(255, 255, 255, 0.9);
  }

  .button {
    justify-content: flex-start;
    margin-left: 16px;
    margin-right: 16px;
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .button-label {
    transform-translate-y: 1px;
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">Hand Control</div>
    <Divider></Divider>
    <div id="hand-status" class="status">Your Room</div>
    <div class="sub-heading">
      Aim with the other hand and pull the trigger.
    </div>
  </div>
  <Button id="btn-dive-hand" class="button">
    <ButtonLabel class="button-label">Dive</ButtonLabel>
  </Button>
  <Button id="btn-return-hand" class="button" style="display: none">
    <ButtonLabel class="button-label">Return</ButtonLabel>
  </Button>
</Panel>
